# Environment variables — copy to .env and fill in values
# DO NOT commit .env to git

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model paths
MLP_MODEL_PATH=models/asl_mlp.keras
LSTM_MODEL_PATH=models/asl_lstm.keras
CNN_MODEL_PATH=models/asl_mobilenet.keras

# Inference settings
CONFIDENCE_THRESHOLD=0.70
SMOOTHING_WINDOW=10

# GPU settings (set to -1 to force CPU)
CUDA_VISIBLE_DEVICES=0
