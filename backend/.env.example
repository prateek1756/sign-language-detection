# Environment variables — copy to .env and fill in values
# DO NOT commit .env to git

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Google Drive model download ───────────────────────────────────────────────
# Paste the shareable Drive link for each trained .keras file.
# How to get the link:
#   1. Right-click the .keras file in Google Drive
#   2. Share → Anyone with the link → Copy link
#   3. Paste the full URL below
# Leave blank to skip automatic download (place .keras files in backend/models/ manually).
GDRIVE_MODEL_URL_MLP=
GDRIVE_MODEL_URL_LSTM=
GDRIVE_MODEL_URL_CNN=

# ── Inference settings ────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.70
SMOOTHING_WINDOW=10

# ── GPU settings ──────────────────────────────────────────────────────────────
# Set to -1 to force CPU inference
CUDA_VISIBLE_DEVICES=0
